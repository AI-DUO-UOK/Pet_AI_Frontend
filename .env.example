# Backend API Configuration
# Copy this to .env.local to customize

# Chatbot API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# CV Model API URL (optional, used by backend)
NEXT_PUBLIC_CV_API_URL=http://localhost:8000

# Feature flags
NEXT_PUBLIC_ENABLE_RAG=true
NEXT_PUBLIC_ENABLE_IMAGE_UPLOAD=true
NEXT_PUBLIC_ENABLE_DISEASE_ANALYSIS=true

# Timeouts (in ms)
NEXT_PUBLIC_API_TIMEOUT=30000
